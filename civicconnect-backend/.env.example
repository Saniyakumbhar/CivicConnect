# Copy this file to ".env" and fill in the values. NEVER commit ".env" to GitHub.

PORT=5000

# Local MongoDB:      mongodb://127.0.0.1:27017/civicconnect
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/civicconnect
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address (CORS). Vite default is 5173.
CLIENT_ORIGIN=http://localhost:5173

# First admin account created by:  npm run seed:admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@civicconnect.gov.in
ADMIN_PASSWORD=ChangeThisAdminPassword1
